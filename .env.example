# Claude extraction (optional if using OpenAI or a connected ChatGPT plan)
ANTHROPIC_API_KEY=

# OpenAI API extraction, billed to your OpenAI Platform account
OPENAI_API_KEY=
# OPENAI_MODEL=gpt-6.1-sol

# Optional manual OAuth access token issued for THIS app with ChatGPT plan usage.
# Prefer the UI's "Continue with ChatGPT" flow, which also handles token refresh.
# A cached Codex session token is not guaranteed to authorize this app.
# OPENAI_ACCESS_TOKEN=

# Optional explicit provider: claude | openai | chatgpt
# Default: connected ChatGPT plan, then OpenAI API key, then Claude.
# LLM_PROVIDER=chatgpt

# Local credentials default to .chatgpt/ (gitignored). One server process per directory.
# CHATGPT_AUTH_DIR=/absolute/path/to/private/rfq-parser-chatgpt

# Optional: enables the live materials catalog and the "Submit to Nox" button
NOX_API_KEY=
# NOX_API_BASE_URL=https://developer-api.noxmetals.co

# Set to 1 to return a canned extraction instead of calling Claude
# MOCK_LLM=1
